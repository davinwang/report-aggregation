# ---- App ----
APP_NAME=股票研报聚合平台
ENV=dev
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (SQLite only; path relative to backend/) ----
DATABASE_URL=sqlite:///../data/srp.sqlite3

# ---- Auth (Phase 2) ----
# Login is disabled by default: all requests act as a hardcoded admin (no login UI).
# Set AUTH_ENABLED=true to require JWT for /ops, /admin, /contrib.
AUTH_ENABLED=false
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---- Ingestion ----
# Default universe for per-symbol feeds: hs300 | zz500 | hs300+zz500 | all
UNIVERSE=hs300
AKSHARE_TIMEOUT=30
AKSHARE_MAX_RETRIES=3
AKSHARE_THROTTLE_SECONDS=0.4
SCHEDULER_ENABLED=true

# Frequency-based schedule groups (5-field cron: minute hour dom mon dow,
# Asia/Shanghai; day-of-week uses APScheduler names: mon tue wed thu fri sat sun).
# 盘中实时快照 (市场看板/全市场速览/板块热力): A股交易时段每10分钟
SCHEDULER_CRON_INTRADAY=*/10 9-11,13-15 * * mon-fri
# 收盘后日频行情 (技术指标/股指期货基差/股指期权): 工作日 16:30
SCHEDULER_CRON_DAILY_CLOSE=30 16 * * mon-fri
# 晚间日频数据 (资金流向/龙虎榜/研报库/可操作信号/公告): 工作日 19:00
SCHEDULER_CRON_DAILY_EVENING=0 19 * * mon-fri
# 周度主数据 (证券主档/行业成分): 周一 08:00
SCHEDULER_CRON_WEEKLY_MASTER=0 8 * * mon
# 周度财报 (业绩/财务指标/三大报表): 周六 12:00
SCHEDULER_CRON_WEEKLY_FINANCIALS=0 12 * * sat
# 资讯舆情快讯 (东财/财联社): 每日 07:00-23:00 每20分钟 (含周末)
SCHEDULER_CRON_NEWS=2-59/20 7-23 * * *

# Startup bootstrap: 空库自动全量种子 (新部署即有数据);
# 行情数据落后超过 N 天则启动时补跑日频任务。
INGEST_BOOTSTRAP=true
INGEST_BOOTSTRAP_STALE_DAYS=3

# ---- Feature flags ----
FEATURE_AI=false
# MCP 工具出口 (外部 AI 客户端接入, 端点 /mcp, 见 README "MCP 接入")
FEATURE_MCP=true
# MCP 访问令牌: 留空则免鉴权 (内网/开发默认); 生产部署建议设置
MCP_TOKEN=
# MCP 允许的 Host (逗号分隔), 仅在非 localhost 访问时需要, 如: 192.168.1.5:*,myhost.lan
MCP_ALLOWED_HOSTS=
